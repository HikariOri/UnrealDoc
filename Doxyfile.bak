# Run from the repository root: doxygen Engine/Saved/UEClassDiagrams/Doxyfile
# Edit INPUT to study another small group of headers.
PROJECT_NAME           = "UE 5.8 Core Class Example"
OUTPUT_DIRECTORY       = Engine/Saved/UEClassDiagrams
INPUT                  = Engine/Source/Runtime/CoreUObject/Public/UObject/UObjectBase.h \
                         Engine/Source/Runtime/CoreUObject/Public/UObject/UObjectBaseUtility.h \
                         Engine/Source/Runtime/CoreUObject/Public/UObject/Object.h \
                         Engine/Source/Runtime/Engine/Classes/Engine/World.h \
                         Engine/Source/Runtime/Engine/Classes/GameFramework/Actor.h \
                         Engine/Source/Runtime/Engine/Classes/GameFramework/Pawn.h \
                         Engine/Source/Runtime/Engine/Classes/GameFramework/Character.h \
                         Engine/Source/Runtime/Engine/Classes/GameFramework/Controller.h \
                         Engine/Source/Runtime/Engine/Classes/GameFramework/PlayerController.h \
                         Engine/Source/Runtime/Engine/Classes/GameFramework/Info.h \
                         Engine/Source/Runtime/Engine/Classes/GameFramework/GameModeBase.h \
                         Engine/Source/Runtime/Engine/Classes/GameFramework/GameStateBase.h \
                         Engine/Source/Runtime/Engine/Classes/Components/ActorComponent.h \
                         Engine/Source/Runtime/Engine/Classes/Components/SceneComponent.h
RECURSIVE              = NO
EXTRACT_ALL            = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
QUIET                  = YES
WARN_LOGFILE           = Engine/Saved/UEClassDiagrams/warnings.log

# UE macros are reduced to empty tokens for this small example. Add the
# relevant <MODULE>_API macro when analyzing headers from other modules.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
PREDEFINED             = "UCLASS(...)=" "USTRUCT(...)=" "UENUM(...)=" \
                         "UINTERFACE(...)=" "UPROPERTY(...)=" "UFUNCTION(...)=" \
                         "GENERATED_BODY(...)=" "UE_DEPRECATED(...)=" \
                         COREUOBJECT_API= ENGINE_API=

HAVE_DOT               = YES
CLASS_GRAPH            = YES
GRAPHICAL_HIERARCHY    = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
UML_LOOK               = YES
DOT_UML_DETAILS        = NONE
DOT_GRAPH_MAX_NODES    = 75
MAX_DOT_GRAPH_DEPTH    = 4
