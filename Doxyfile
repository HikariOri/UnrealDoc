# 默认值：YES。
# 此项要求 GENERATE_LATEX 设为 YES。

USE_PDFLATEX           = YES

# 控制 LaTeX 遇到错误时的行为。NO 等同于 ERROR_STOP，YES 等同于 BATCH。BATCH 不向终端打印信息，
