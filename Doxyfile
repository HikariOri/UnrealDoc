MATHJAX_VERSION        = MathJax_2

# 启用 MathJax 时指定默认输出格式。详情参见 MathJax 2：https://docs.mathjax.org/en/v2.7/output.html；
# MathJax 3：https://docs.mathjax.org/en/v3.2/output/index.html；
# MathJax 4：https://docs.mathjax.org/en/v4.0/output/index.htm。
# 可选值：HTML-CSS（较慢但兼容性最好，是 MathJax 2 的名称，在 MathJax 3 中转换为 chtml）；
# NativeMML（即 MathML，仅 MathJax 2 支持，MathJax 3 改用 chtml）；chtml（MathJax 3 的名称，
