# 启用时由外部工具提供索引与搜索。详情参见“External Indexing and Searching”。
# 默认值：NO。
# 此项要求 SEARCHENGINE 设为 YES。

SERVER_BASED_SEARCH    = NO

# 启用后，Doxygen 不再生成 PHP 搜索脚本，而是将搜索数据写入 XML 文件，由外部索引器处理，
