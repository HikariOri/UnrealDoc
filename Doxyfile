# 默认值：YES。

STRIP_CODE_COMMENTS    = YES

# 设为 YES 时，为每个已有文档的实体列出所有引用它的已有文档函数。
# 默认值：NO。

REFERENCED_BY_RELATION = NO

# 设为 YES 时，为每个已有文档的函数列出它调用或使用的所有已有文档实体。
# 默认值：NO。

REFERENCES_RELATION    = NO

# 当此项和 SOURCE_BROWSER 均为 YES 时，
# REFERENCES_RELATION 和 REFERENCED_BY_RELATION 列表中的函数超链接指向源代码；否则指向文档。
# 默认值：YES。

REFERENCES_LINK_SOURCE = YES

# 启用时（默认），鼠标悬停在源代码超链接上会显示提示，包含函数原型、简要说明及指向定义和文档的链接。
# 由于这会增大 HTML 文件并稍微降低大文件加载速度，可以选择关闭。
# 默认值：YES。
# 此项要求 SOURCE_BROWSER 设为 YES。

SOURCE_TOOLTIPS        = YES

# 设为 YES 时，源码引用指向 htags(1) 工具生成的 HTML，而非 Doxygen 内置源码浏览器。
# htags 属于 GNU global 源码标记系统（https://www.gnu.org/software/global/global.html），
# 需要 4.8.6 或更高版本。
# 使用方法：安装最新版 global；在配置文件中启用 SOURCE_BROWSER 和 USE_HTAGS；
# 确保 INPUT 指向源代码树的根目录；正常运行 doxygen。Doxygen 会调用 htags，后者再调用 gtags，
# 因此这些工具必须可从命令行访问，即位于搜索路径中。最终源码链接将指向 htags 输出。
# 默认值：NO。
# 此项要求 SOURCE_BROWSER 设为 YES。

USE_HTAGS              = NO

# 设为 YES 时，Doxygen 为每个指定了 include 的类生成其头文件的原样副本；设为 NO 可关闭。
# 另见 \class 章节。
# 默认值：YES。

VERBATIM_HEADERS       = YES

# 设为 YES 时使用 clang 解析器（http://clang.llvm.org/），以降低性能为代价提高解析准确度。
# 这对模板较多、Doxygen 内置解析器缺乏必要类型信息的 C++ 代码尤其有用。
# 注意：此选项是否可用取决于构建 Doxygen 时是否为 CMake 设置 -Duse_libclang=ON。
# 默认值：NO。

CLANG_ASSISTED_PARSING = NO

# 当 CLANG_ASSISTED_PARSING 和此项均为 YES 时，Doxygen 将每个输入项的目录加入包含路径。
# 默认值：YES。
# 此项要求 CLANG_ASSISTED_PARSING 设为 YES。

CLANG_ADD_INC_PATHS    = YES

# 启用 clang 辅助解析时，可提供通常调用编译器时使用的命令行选项。
# 对于 INPUT 和 INCLUDE_PATH 中指定的文件与目录，Doxygen 已自动设置包含路径。
# 此项要求 CLANG_ASSISTED_PARSING 设为 YES。

CLANG_OPTIONS          =

# 启用 clang 辅助解析时，可指定包含 compile_commands.json 的目录。
# 该文件是编译数据库（http://clang.llvm.org/docs/HowToSetupToolingForLLVM.html），
# 包含构建源文件时使用的选项，相当于向 clang-check 等 clang 工具指定 -p 选项。
# 这些选项以及 CLANG_OPTIONS 中指定的选项会传给解析器。
# 注意：此选项是否可用取决于构建 Doxygen 时是否为 CMake 设置 -Duse_libclang=ON。

CLANG_DATABASE_PATH    =

#---------------------------------------------------------------------------
# 类字母索引相关配置选项
#---------------------------------------------------------------------------

# 设为 YES 时，生成所有复合类型的字母索引。项目包含大量类、结构体、联合体或接口时可启用。
# 默认值：YES。

ALPHABETICAL_INDEX     = YES

# 指定生成索引标题时要忽略的一个或多个前缀，适用于类、函数和成员名称。去除前缀后，
# 实体按剩余名称的第一个字母归入字母列表。
# 此项要求 ALPHABETICAL_INDEX 设为 YES。

IGNORE_PREFIX          =

#---------------------------------------------------------------------------
# HTML 输出相关配置选项
#---------------------------------------------------------------------------

# 设为 YES 时生成 HTML 输出。
# 默认值：YES。

GENERATE_HTML          = YES

# 指定 HTML 文档的输出位置；使用相对路径时，以 OUTPUT_DIRECTORY 为基准。
# 默认目录：html。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_OUTPUT            = html

# 指定每个生成的 HTML 页面使用的文件扩展名，例如 .htm、.php 或 .asp。
# 默认值：.html。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_FILE_EXTENSION    = .html

# 为每个生成的 HTML 页面指定自定义页眉文件；留空时生成标准页眉。
# 为了生成有效 HTML，页眉必须包含 Doxygen 所需的脚本和样式表，
# 具体取决于所用配置（例如 GENERATE_TREEVIEW）。强烈建议先运行以下命令生成默认页眉，
# 再修改 new_header.html：
# doxygen -w html new_header.html new_footer.html new_stylesheet.css YourConfigFile
# 生成 Doxygen 通常使用的默认页眉的方法另见“Doxygen usage”。页眉可能随版本变化，
# 因此升级 Doxygen 时通常需要重新生成。可用标记和块名称的说明参见文档。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_HEADER            = Engine\Saved\UnrealDoc\doxygen\header.html

# 为每个生成的 HTML 页面指定自定义页脚；留空时生成标准页脚。
# 生成默认页脚的方法及页脚内可用的特殊命令参见 HTML_HEADER；另见“Doxygen usage”。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_FOOTER            =

# 指定所有 HTML 页面使用的自定义层叠样式表，可微调 HTML 输出外观；留空时生成默认样式表。
# 生成 Doxygen 通常使用的样式表的方法参见“Doxygen usage”。
# 建议改用更稳健的 HTML_EXTRA_STYLESHEET，因为 HTML_STYLESHEET 将来会被废弃。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_STYLESHEET        =

# 指定额外的自定义层叠样式表，在 Doxygen 创建的标准样式表之后引入，以覆盖部分样式。
# 此方式不替换标准样式表，比 HTML_STYLESHEET 更能适应未来更新。Doxygen 会将样式表复制到输出目录。
# 额外样式表的顺序很重要，例如列表中靠后的样式表会覆盖前面的设置。
# 由于目前无法在 WebKit／Chromium 中覆盖滚动条样式，指定一个或多个额外样式表时，
# 默认 doxygen.css 将省略滚动条样式；如需自定义，必须显式添加。示例参见文档。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_EXTRA_STYLESHEET  = Engine/Saved/UnrealDoc/doxygen-awesome-css/doxygen-awesome.css \
                        Engine/Saved/UnrealDoc/doxygen-awesome-css/doxygen-awesome-sidebar-only.css \
                        Engine/Saved/UnrealDoc/doxygen-awesome-css/doxygen-awesome-sidebar-only-darkmode-toggle.css 

# 指定要复制到 HTML 输出目录的额外图片或其他源文件。这些文件复制到 HTML 输出根目录；
# 在 HTML_HEADER 和／或 HTML_FOOTER 文件中使用 $relpath^ 标记加载，
# 在 HTML_STYLESHEET 中只需使用文件名。文件按原样复制，不支持命令或标记。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_EXTRA_FILES       = Engine/Saved/UnrealDoc/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
                        Engine/Saved/UnrealDoc/doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
                        Engine/Saved/UnrealDoc/doxygen-awesome-css/doxygen-awesome-paragraph-link.js \
                        Engine/Saved/UnrealDoc/doxygen-awesome-css/doxygen-awesome-interactive-toc.js

# 指定生成的 HTML 使用深色还是浅色主题。LIGHT 始终使用浅色；DARK 始终使用深色；
# AUTO_LIGHT 根据用户偏好自动选择，未设置偏好时使用浅色（默认）；AUTO_DARK 根据用户偏好自动选择，
# 未设置时使用深色；TOGGLE 允许用户通过按钮切换。
# 默认值：AUTO_LIGHT。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_COLORSTYLE        = LIGHT

# 控制 HTML 输出颜色。Doxygen 根据此颜色调整样式表和背景图。色相以色轮角度指定，
# 详见 https://en.wikipedia.org/wiki/Hue：0 为红色，60 为黄色，120 为绿色，180 为青色，240 为蓝色，
# 300 为紫色，360 又为红色。
# 最小值：0，最大值：359，默认值：220。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_COLORSTYLE_HUE    = 220

# 控制 HTML 输出颜色的纯度或饱和度。0 仅使用灰度，255 产生最鲜艳的颜色。
# 最小值：0，最大值：255，默认值：100。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_COLORSTYLE_SAT    = 100

# 控制 HTML 输出颜色亮度分量的伽马校正。低于 100 会逐渐使输出变亮，高于 100 会变暗。
# 实际伽马值为此值除以 100：80 对应 0.8，220 对应 2.2，100 不改变伽马值。
# 最小值：40，最大值：240，默认值：80。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_COLORSTYLE_GAMMA  = 80

# 设为 YES 时，生成的 HTML 文档主索引包含由 JavaScript 动态创建的垂直导航菜单；关闭时，
# 导航索引使用静态嵌入每个 HTML 页面的多级标签。要支持不运行 JavaScript 的浏览器（如 Qt 帮助浏览器），
# 请关闭此项。
# 默认值：YES。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_DYNAMIC_MENUS     = YES

# 设为 YES 时，生成的 HTML 文档包含可在页面加载后展开和隐藏的章节。
# 默认值：NO。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_DYNAMIC_SECTIONS  = NO

# 设为 YES 时，生成的 HTML 源代码中的类和函数可以动态折叠与展开。
# 默认值：YES。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_CODE_FOLDING      = YES

# 设为 YES 时，在代码和文本片段右上角显示复制图标，供用户将内容复制到剪贴板。此功能要求浏览器支持，
# 并且页面处于安全上下文中，即使用 https: 或 file: 协议；参见 https://www.w3.org/TR/secure-contexts/。
# 默认值：YES。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_COPY_CLIPBOARD    = NO

# Doxygen 会通过 cookie 等方式在浏览器中持久保存一些设置。
# 默认这些设置适用于所有项目中由 Doxygen 生成的 HTML 页面；此项可指定项目专用键，使用户偏好分别保存。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_PROJECT_COOKIE    =

# 控制各种树形索引初始显示的首选条目数量；用户之后仍可动态展开和折叠。
# Doxygen 将树展开到可见条目不超过指定数量的级别，除非完全折叠后已超过该数量。设为 1 时默认完全折叠；
# 0 表示无限条目，默认完全展开。
# 最小值：0，最大值：9999，默认值：100。
# 此项要求 GENERATE_HTML 设为 YES。

HTML_INDEX_NUM_ENTRIES = 100

# 设为 YES 时，生成可供 Apple Xcode 3 集成开发环境使用的额外索引文件，
# 参见 https://developer.apple.com/xcode/；该环境随 OS X 10.5（Leopard）推出。
# Doxygen 在 HTML 输出目录中生成 Makefile，运行 make 可在该目录生成 docset，
# 运行 make install 可将其安装到 ~/Library/Developer/Shared/Documentation/DocSets，
# 使 Xcode 启动时能够找到。
# 更多信息参见 https://developer.apple.com/library/archive/featuredarticles/DoxygenXcode/_index.html。
# 默认值：NO。
# 此项要求 GENERATE_HTML 设为 YES。

GENERATE_DOCSET        = NO

# 指定 docset 信息源名称。一个文档信息源可将同一提供者（例如公司或产品套件）的多个文档集归在一起。
# 默认值：Doxygen generated docs。
# 此项要求 GENERATE_DOCSET 设为 YES。

DOCSET_FEEDNAME        = "Doxygen generated docs"

# 指定 docset 信息源 URL。一个文档信息源可将同一提供者（例如公司或产品套件）的多个文档集归在一起。
# 此项要求 GENERATE_DOCSET 设为 YES。

DOCSET_FEEDURL         =

# 指定唯一标识文档集包的字符串，应采用反向域名格式，例如 com.mycompany.MyDocSet。
# Doxygen 会在名称后附加 .docset。
# 默认值：org.doxygen.Project。
# 此项要求 GENERATE_DOCSET 设为 YES。

DOCSET_BUNDLE_ID       = org.doxygen.Project

# 指定唯一标识文档发布者的字符串，应采用反向域名格式，例如 com.mycompany.MyDocSet.documentation。
# 默认值：org.doxygen.Publisher。
# 此项要求 GENERATE_DOCSET 设为 YES。

DOCSET_PUBLISHER_ID    = org.doxygen.Publisher

# 指定文档发布者名称。
# 默认值：Publisher。
# 此项要求 GENERATE_DOCSET 设为 YES。

DOCSET_PUBLISHER_NAME  = Publisher

# 设为 YES 时，额外生成 index.hhp、index.hhc 和 index.hhk 三个 HTML 索引文件。
# index.hhp 是 Windows 上 Microsoft HTML Help Workshop 可读取的项目文件。
# Microsoft 于 2021 年初下线了原下载页面；
# 可从网页档案下载安装程序：http://web.archive.org/web/20160201063255/http://download.microsoft.com/download/0/A/9/0A939EF6-E31C-430F-A3DF-DFAE7960D564/htmlhelp.exe。
# HTML Help Workshop 包含编译器，
# 可将 Doxygen 生成的全部 HTML 输出转换为一个编译后的 HTML 文件（.chm）。
# 原注释称该格式用于 Windows 98 帮助，并将取代旧的 Windows 帮助格式（.hlp）。
# 压缩 HTML 文件还包含索引和目录，支持搜索；该工具也包含查看器。
# 默认值：NO。
# 此项要求 GENERATE_HTML 设为 YES。

GENERATE_HTMLHELP      = NO

# 指定生成的 .chm 文件名。如果不希望将结果写入 HTML 输出目录，可在文件名前添加路径。
# 此项要求 GENERATE_HTMLHELP 设为 YES。

CHM_FILE               =

# 指定 HTML 帮助编译器 hhc.exe 的位置，必须是包含文件名的完整绝对路径。非空时，
# Doxygen 尝试使用该编译器处理生成的 index.hhp。
# 此项要求 GENERATE_HTMLHELP 设为 YES。

HHC_LOCATION           =

# 设为 YES 时生成单独的 .chi 索引文件；设为 NO 时将索引包含在主 .chm 文件中。
# 默认值：NO。
# 此项要求 GENERATE_HTMLHELP 设为 YES。

GENERATE_CHI           = NO

# 指定 HTML Help 索引（hhk）、目录（hhc）和项目文件内容的编码。
# 此项要求 GENERATE_HTMLHELP 设为 YES。

CHM_INDEX_ENCODING     =

# 控制 .chm 文件中生成二进制目录（YES）还是普通目录（NO）；还会启用上一页和下一页按钮。
# 默认值：NO。
# 此项要求 GENERATE_HTMLHELP 设为 YES。

BINARY_TOC             = NO

# 设为 YES 时，为 HTML 帮助文档目录和树视图中的组成员添加额外条目。
# 默认值：NO。
# 此项要求 GENERATE_HTMLHELP 设为 YES。

TOC_EXPAND             = NO

# 指定用户部署生成文档时在服务器上放置文档的位置的完整 URL。生成的站点地图名为 sitemap.xml，
# 存放在 HTML_OUTPUT 指定的目录；未指定此项时不生成站点地图。协议说明见 https://www.sitemaps.org。
# 此项要求 GENERATE_HTML 设为 YES。

SITEMAP_URL            =

# 设为 YES 且 QHP_NAMESPACE 和 QHP_VIRTUAL_FOLDER 均已设置时，生成额外索引文件，
# 可供 Qt 的 qhelpgenerator 将生成的 HTML 文档转换为 Qt 压缩帮助文件（.qch）。
# 默认值：NO。
# 此项要求 GENERATE_HTML 设为 YES。

GENERATE_QHP           = NO

# 指定 QHG_LOCATION 后，此项可指定生成的 .qch 文件名。路径相对于 HTML 输出目录。
# 此项要求 GENERATE_QHP 设为 YES。

QCH_FILE               =

# 指定生成 Qt Help Project 输出时使用的命名空间，
# 详见 https://doc.qt.io/archives/qt-4.8/qthelpproject.html#namespace。
# 默认值：org.doxygen.Project。
# 此项要求 GENERATE_QHP 设为 YES。

QHP_NAMESPACE          = org.doxygen.Project

# 指定生成 Qt Help Project 输出时使用的虚拟目录，
# 详见 https://doc.qt.io/archives/qt-4.8/qthelpproject.html#virtual-folders。
# 默认值：doc。
# 此项要求 GENERATE_QHP 设为 YES。

QHP_VIRTUAL_FOLDER     = doc

# 设置时，指定要添加的自定义过滤器名称，
# 详见 https://doc.qt.io/archives/qt-4.8/qthelpproject.html#custom-filters。
# 此项要求 GENERATE_QHP 设为 YES。

QHP_CUST_FILTER_NAME   =

# 指定要添加的自定义过滤器的属性列表，
# 详见 https://doc.qt.io/archives/qt-4.8/qthelpproject.html#custom-filters。
# 此项要求 GENERATE_QHP 设为 YES。

QHP_CUST_FILTER_ATTRS  =

# 指定项目过滤器章节匹配的属性列表，
# 详见 https://doc.qt.io/archives/qt-4.8/qthelpproject.html#filter-attributes。
# 此项要求 GENERATE_QHP 设为 YES。

QHP_SECT_FILTER_ATTRS  =

# 指定 Qt 的 qhelpgenerator 的位置，即包含文件名的绝对路径。非空时，
# Doxygen 尝试使用它处理生成的 .qhp 文件。
# 此项要求 GENERATE_QHP 设为 YES。

QHG_LOCATION           =

# 设为 YES 时生成额外索引文件，与 HTML 文件共同构成 Eclipse 帮助插件。
# 要安装插件并使其出现在 Eclipse 的帮助内容菜单中，
# 应将包含 HTML 和 XML 文件的目录内容复制到 Eclipse 的 plugins 目录下；
# plugins 中对应的目录名应与 ECLIPSE_DOC_ID 的值相同。复制后需重新启动 Eclipse 才能看到帮助。
# 默认值：NO。
# 此项要求 GENERATE_HTML 设为 YES。

GENERATE_ECLIPSEHELP   = NO

# Eclipse 帮助插件的唯一标识符。安装插件时，包含 HTML 和 XML 文件的目录也应使用此名称；
# 每个文档集应有自己的标识符。
# 默认值：org.doxygen.Project。
# 此项要求 GENERATE_ECLIPSEHELP 设为 YES。

ECLIPSE_DOC_ID         = org.doxygen.Project

# 控制是否关闭每个 HTML 页面顶部的精简索引（标签），以便完全控制布局或替换为自定义索引。NO 启用，
# YES 关闭。由于索引标签与导航树包含相同信息，GENERATE_TREEVIEW 为 YES 时可以将此项设为 YES。
# 默认值：NO。
# 此项要求 GENERATE_HTML 设为 YES。

DISABLE_INDEX          = NO

# 指定是否生成用于显示层次信息的树形索引。设为 YES 时，生成包含树形索引的侧面板，类似 HTML Help；
# 浏览器需支持 JavaScript、DHTML、CSS 和框架，即现代浏览器通常均可。
# Windows 用户可能更适合使用 HTML 帮助。
# 可通过自定义样式表（见 HTML_EXTRA_STYLESHEET）进一步调整索引外观，参见“Fine-tuning the output”。
# Doxygen 默认样式表中的示例展示了如何在树根使用图片代替 PROJECT_NAME。树视图通常比标签索引更详细，
# 因此启用此项时可考虑将 DISABLE_INDEX 设为 YES。
# 默认值：YES。
# 此项要求 GENERATE_HTML 设为 YES。

GENERATE_TREEVIEW      = YES

# 当 GENERATE_TREEVIEW 为 YES 时，控制是否在屏幕右侧显示额外导航面板，列出主页内容大纲，
# 例如 https://developer.android.com/reference。GENERATE_TREEVIEW 为 NO 时此项无效。
# 默认值：YES。
# 此项要求 GENERATE_HTML 设为 YES。

PAGE_OUTLINE_PANEL     = YES

