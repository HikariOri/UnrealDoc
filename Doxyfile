# Doxygen 附带示例索引器 doxyindexer 和搜索引擎 doxysearch.cgi，
# 基于开源搜索引擎库 Xapian（https://xapian.org/）。详情参见“External Indexing and Searching”。
# 默认值：NO。
# 此项要求 SEARCHENGINE 设为 YES。

EXTERNAL_SEARCH        = NO

# 指定 Web 服务器托管的搜索引擎地址，EXTERNAL_SEARCH 启用时由其返回搜索结果。
