# 默认值：makeindex。
# 此项要求 GENERATE_LATEX 设为 YES。

LATEX_MAKEINDEX_CMD    = makeindex

# 设为 YES 时生成更紧凑的 LaTeX 文档，适合小型项目，也有助于节省纸张。
