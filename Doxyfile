# 详情参见“External Indexing and Searching”。
# 此项要求 SEARCHENGINE 设为 YES。

SEARCHENGINE_URL       =

# 当 SERVER_BASED_SEARCH 和 EXTERNAL_SEARCH 均启用时，
# 未建立索引的搜索数据会写入文件供外部工具建立索引；此项指定该文件名。
# 默认文件：searchdata.xml。
# 此项要求 SEARCHENGINE 设为 YES。

SEARCHDATA_FILE        = searchdata.xml

# 当 SERVER_BASED_SEARCH 和 EXTERNAL_SEARCH 均启用时，此项可作为项目标识符。
