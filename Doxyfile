# 格式：EXTRA_SEARCH_MAPPINGS = tagname1=loc1 tagname2=loc2 ...。
# 此项要求 SEARCHENGINE 设为 YES。

EXTRA_SEARCH_MAPPINGS  =

#---------------------------------------------------------------------------
# LaTeX 输出相关配置选项
#---------------------------------------------------------------------------

# 设为 YES 时生成 LaTeX 输出。
