# 为 amsmath 包使用 intlimits 选项可指定 EXTRA_PACKAGES=[intlimits]{amsmath}。留空时不包含额外包。
# 此项要求 GENERATE_LATEX 设为 YES。

EXTRA_PACKAGES         =

