# 默认值：HTML-CSS。
# 此项要求 USE_MATHJAX 设为 YES。

MATHJAX_FORMAT         = HTML-CSS

# 启用 MathJax 时，指定其相对于 HTML 输出目录的位置。MathJax 2 的目标目录应包含 MathJax.js；
