# 默认值：YES。
# 此项要求 GENERATE_LATEX 设为 YES。

PDF_HYPERLINKS         = YES

# 设为 YES 时，使用 LATEX_CMD_NAME 指定的引擎直接从 LaTeX 文件生成 PDF，可获得更高质量的 PDF 文档。
