# MathJax 3：https://cdn.jsdelivr.net/npm/mathjax@3；
# MathJax 4：https://cdn.jsdelivr.net/npm/mathjax@4。
# 此项要求 USE_MATHJAX 设为 YES。

MATHJAX_RELPATH        =

