# Doxyfile 1.15.0

# 本文件描述 Doxygen 文档系统（www.doxygen.org）用于项目的设置。
#
# 双井号（##）之后的所有文本都视为注释，并放在其后配置项的前面。
#
# 单井号（#）之后的所有文本都视为注释并被忽略。格式如下：
# TAG = value [value, ...]
# 对于列表，也可以使用以下方式追加项目：
# TAG += value [value, ...]
# 包含空格的值应放在双引号中（" "）。
#
# 注意：
# 使用 Doxygen 将当前配置文件与模板配置文件进行比较：
# doxygen -x [configFile]
# 如果比较时不替换环境变量或 CMake 类型的替换变量，请使用：
# doxygen -x_noenv [configFile]

#---------------------------------------------------------------------------
# 项目相关配置选项
#---------------------------------------------------------------------------

# 指定此项之后配置文件中所有字符的编码。默认值 UTF-8 也用于此项首次出现之前的所有文本。
# Doxygen 使用 libiconv（或 libc 内置的 iconv）进行转码；
# 支持的编码列表见 https://www.gnu.org/software/libiconv/。
# 默认值：UTF-8。

DOXYFILE_ENCODING      = UTF-8

# 指定生成文档所属项目的名称。名称可以是一个单词，
# 也可以是用双引号括起来的一组单词（使用 Doxywizard 时不必加引号）。
# 它会用于大多数生成页面的标题及其他位置。
# 默认值：My Project。

PROJECT_NAME           = "UE 5.8.3"

# 指定项目编号或修订版本号，便于归档生成的文档或配合版本控制系统使用。

PROJECT_NUMBER         = 

# 指定可选的项目单行简介，显示在每个页面顶部，让读者快速了解项目用途。请保持简短。

PROJECT_BRIEF          = "Unreal Engine"

# 指定文档中使用的徽标或图标。图片高度不应超过 55 像素，宽度不应超过 200 像素。
# Doxygen 会将其复制到输出目录。

PROJECT_LOGO           = Engine/Content/Splash/EdIconDefault.bmp

# 指定显示 HTML 文档时用于浏览器标签页的图标。Doxygen 会将图标复制到输出目录。

PROJECT_ICON           = Engine/Content/Splash/EdIconDefault.bmp

# 指定生成文档的输出目录，可以使用相对路径或绝对路径。相对路径以 Doxygen 启动时所在目录为基准；
# 留空则使用当前目录。

OUTPUT_DIRECTORY       = Engine/Saved/UnrealDoc/docs

# 设为 YES 时，Doxygen 会在每种输出格式的输出目录下创建最多 4096 个子目录（分为两级），
# 并将生成的文件分散到这些目录中。处理大量源文件时，
# 这可以避免所有文件集中在同一目录而导致文件系统性能问题。通过 CREATE_SUBDIRS_LEVEL 控制子目录数量。
# 默认值：NO。

CREATE_SUBDIRS         = NO

# 控制 CREATE_SUBDIRS 为 YES 时创建的子目录数量。级别 0 对应 16 个目录，每增加一级数量翻倍；
# 默认的最高级别 8 对应 4096 个目录。子目录分为两级，第一级固定为 16 个目录。
# 最小值：0，最大值：8，默认值：8。
# 此项要求 CREATE_SUBDIRS 设为 YES。

CREATE_SUBDIRS_LEVEL   = 8

# 设为 YES 时，允许生成的文件名中包含非 ASCII 字符；设为 NO 时会将其转义，
# 例如 Unicode U+3044 使用 _xE3_x81_x84 表示。
# 默认值：NO。

ALLOW_UNICODE_NAMES    = NO

# 指定 Doxygen 生成文档的语言，并用于以相应语言生成固定文本。
# 可选值：Afrikaans、Arabic、Armenian、Brazilian、Bulgarian、Catalan、Chinese、Chinese-Traditional、
# Croatian、Czech、Danish、Dutch、English（美国）、Esperanto、Farsi（Persian）、Finnish、French、
# German、Greek、Hindi、Hungarian、Indonesian、Italian、Japanese、Japanese-en（日语及英语消息）、
# Korean、Korean-en（韩语及英语消息）、Latvian、Lithuanian、Macedonian、Norwegian、Persian（Farsi）、
# Polish、Portuguese、Romanian、Russian、Serbian、Serbian-Cyrillic、Slovak、Slovene、Spanish、
# Swedish、Turkish、Ukrainian 和 Vietnamese。
# 默认值：English。

OUTPUT_LANGUAGE        = Chinese

# 设为 YES 时，在文件和类文档的成员列表中为成员附上简要说明，类似 Javadoc；设为 NO 可关闭此功能。
# 默认值：YES。

BRIEF_MEMBER_DESC      = YES

# 设为 YES 时，在成员或函数的详细说明之前再次显示简要说明。
# 注意：如果 HIDE_UNDOC_MEMBERS 和 BRIEF_MEMBER_DESC 均为 NO，则简要说明会被完全隐藏。
# 默认值：YES。

REPEAT_BRIEF           = YES

# 此项通过近似智能的方式缩短简要说明，以生成各种列表中的文本。如果简要说明以列表中的字符串开头，
# 则依次去除这些前缀，并将处理结果用作注释文本；否则原样使用简要说明。留空时使用以下值，
# 其中 $name 自动替换为实体名称：The $name class、The $name widget、The $name file、is、provides、
# specifies、contains、represents、a、an 和 the。

ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the

# 当 ALWAYS_DETAILED_SEC 和 REPEAT_BRIEF 均设为 YES 时，即使只有简要说明，
# Doxygen 也会生成详细说明部分。
# 默认值：NO。

ALWAYS_DETAILED_SEC    = NO

# 设为 YES 时，类文档中会像普通成员一样显示该类的所有继承成员，但不显示基类的构造函数、
# 析构函数和赋值运算符。
# 默认值：NO。

INLINE_INHERITED_MEMB  = NO

# 设为 YES 时，在文件列表和头文件中为文件名添加完整路径；设为 NO 时，使用能够唯一标识文件的最短路径。
# 默认值：YES。

FULL_PATH_NAMES        = YES

# 从路径中去除用户指定的部分。只有指定字符串与路径开头匹配时才会去除，可用来在文件列表中显示相对路径。
# 留空时去除运行 Doxygen 的目录路径。
# 可以指定绝对路径，也可以指定相对路径；相对路径以 Doxygen 启动时所在目录为基准。
# 此项要求 FULL_PATH_NAMES 设为 YES。

STRIP_FROM_PATH        =

# 从类文档中提示读者包含哪个头文件的路径里去除用户指定的部分。留空时只显示包含该类定义的头文件名；
# 否则应列出通常通过 -I 参数传给编译器的包含路径。

STRIP_FROM_INC_PATH    =

# 设为 YES 时，Doxygen 生成更短但可读性较差的文件名。这对 DOS、
# Mac 或 CD-ROM 等不支持长文件名的文件系统可能有用。
# 默认值：NO。

SHORT_NAMES            = NO

# 设为 YES 时，Doxygen 将 Javadoc 风格注释的第一行（到第一个句号、问号或感叹号为止）视为简要说明。
# 设为 NO 时，其行为与普通 Qt 风格注释相同，需要显式使用 @brief 命令提供简要说明。
# 默认值：NO。

JAVADOC_AUTOBRIEF      = NO

# 设为 YES 时，Doxygen 将 /*************** 这样的行视为 Javadoc 风格横幅注释的开头。设为 NO 时，
# 此类注释与普通注释一样，不会被 Doxygen 解析。
# 默认值：NO。

JAVADOC_BANNER         = NO

# 设为 YES 时，Doxygen 将 Qt 风格注释的第一行（到第一个句号、问号或感叹号为止）视为简要说明。
# 设为 NO 时，需要显式使用 \brief 命令提供简要说明。
# 默认值：NO。

QT_AUTOBRIEF           = NO

# 设为 YES 时，Doxygen 将多行 C++ 特殊注释块（即 //! 或 /// 注释块）视为简要说明，这是旧版默认行为。
# 新版默认将其视为详细说明；如需旧行为可设为 YES。
# 注意：设为 YES 后也将不再识别 Rational Rose 注释。
# 默认值：NO。

MULTILINE_CPP_IS_BRIEF = NO

# 默认情况下，Python 文档字符串显示为预格式化文本，不能使用 Doxygen 特殊命令。
# 设为 NO 后可以使用 Doxygen 特殊命令，文档字符串块的内容也会作为 Doxygen 文档显示。
# 默认值：YES。

PYTHON_DOCSTRING       = YES

# 设为 YES 时，没有文档的成员会继承其重新实现的已有文档成员的说明。
# 默认值：YES。

INHERIT_DOCS           = YES

# 设为 YES 时，Doxygen 为每个成员生成单独页面；设为 NO 时，成员文档属于包含它的文件、类或命名空间。
# 默认值：NO。

SEPARATE_MEMBER_PAGES  = NO

# 设置一个制表符对应的空格数。Doxygen 使用此值将代码片段中的制表符替换为空格。
# 最小值：1，最大值：16，默认值：4。

TAB_SIZE               = 4

# 指定可在文档中作为命令使用的别名，格式为 name=value。例如添加 "sideeffect=@par Side Effects:^^" 后，
# 可在文档中使用 \sideeffect（或 @sideeffect），生成标题为 "Side Effects:" 的自定义段落。
# 不能在别名的值中使用 \n 插入输出换行；可以使用 ^^ 插入换行，其效果如同原始文件中的实际换行。
# 值中需要字面量 {、} 或 , 时，须用反斜杠（\）转义；这可能与 \{ 和 \} 命令冲突，建议使用 @{ 和 @}，
# 或使用双重转义（\\{ 和 \\}）。

ALIASES                =

# 如果项目只包含 C 源文件，设为 YES 可使 Doxygen 生成更适合 C 的文档，
# 例如使用不同的名称并省略所有成员列表。
# 默认值：NO。

OPTIMIZE_OUTPUT_FOR_C  = NO

# 如果项目只包含 Java 或 Python 源文件，设为 YES 可生成更适合这些语言的文档，例如将命名空间显示为包，
# 并改变限定作用域的显示方式。
# 默认值：NO。

OPTIMIZE_OUTPUT_JAVA   = NO

# 如果项目包含 Fortran 源文件，设为 YES 可生成更适合 Fortran 的文档。
# 默认值：NO。

OPTIMIZE_FOR_FORTRAN   = NO

# 如果项目包含 VHDL 源文件，设为 YES 可生成更适合 VHDL 的文档。
# 默认值：NO。

OPTIMIZE_OUTPUT_VHDL   = NO

# 如果项目只包含 Slice 源文件，设为 YES 可生成更适合 Slice 的文档，例如将命名空间显示为模块，
# 并将类型分成更多组。
# 默认值：NO。

OPTIMIZE_OUTPUT_SLICE  = NO

# Doxygen 根据文件扩展名选择解析器。此项可覆盖或扩展内置映射，格式为 ext=language，其中 ext 是扩展名，
# language 是 Doxygen 支持的解析器：IDL、Java、JavaScript、Csharp（C#）、C、C++、Lex、D、PHP、
# md（Markdown）、Objective-C、Python、Slice、VHDL、FortranFixed（固定格式 Fortran）、
# FortranFree（自由格式 Fortran）或 Fortran（格式未知，解析器尝试自动判断，
# 也是 Fortran 文件的默认解析器）。
# 例如 inc=Fortran f=C 将 .inc 文件按 Fortran（默认是 PHP）、.f 文件按 C（默认是 Fortran）解析。
# 无扩展名文件可使用 no_extension 占位。
# 自定义扩展名还需要添加到 FILE_PATTERNS，否则 Doxygen 不会读取相应文件；
# 使用 no_extension 时应在 FILE_PATTERNS 中添加 *。另请参阅默认文件扩展名映射列表。

EXTENSION_MAPPING      =

# 启用后，Doxygen 按 Markdown 格式预处理所有注释，使文档更易读，
# 详见 https://daringfireball.net/projects/markdown/。预处理结果还会由 Doxygen 进一步处理，
# 因此可以混用 Doxygen、HTML、XML 命令与 Markdown 格式。仅在存在向后兼容问题时关闭。
# 默认值：YES。

MARKDOWN_SUPPORT       = YES

# 启用后，当 Doxygen 原生标记格式与 Markdown 冲突时，注释仍按 Markdown 处理。
# 这仅与反引号有关：Doxygen 原生格式允许用单引号结束由反引号开始的片段，并将其视为引用文本；
# Markdown 将其视为原样文本，直到遇到匹配的第二个反引号才结束。
# 原生格式还要求转义反引号片段中的双引号，而 Markdown 不需要。
# 默认值：YES。
# 此项要求 MARKDOWN_SUPPORT 设为 YES。

MARKDOWN_STRICT        = YES

# 设为非零值时，直到该级别的所有标题都会自动加入目录，即使没有 id 属性。
# 目前此功能仅适用于 Markdown 标题。
# 最小值：0，最大值：99，默认值：6。
# 此项要求 MARKDOWN_SUPPORT 设为 YES。

TOC_INCLUDE_HEADINGS   = 6

# 指定生成 Markdown 标题标识符的算法；每个标识符均唯一。
# DOXYGEN 使用固定字符串 'autotoc_md' 加从 0 开始的序号；GITHUB 使用标题的小写形式，
# 将空白替换为 '-' 并删除标点。
# 默认值：DOXYGEN。
# 此项要求 MARKDOWN_SUPPORT 设为 YES。

MARKDOWN_ID_STYLE      = DOXYGEN

# 启用后，Doxygen 尝试将与已有文档的类或命名空间对应的单词链接到相应文档。
# 可在单词前加 % 禁止该处自动链接，也可将 AUTOLINK_SUPPORT 设为 NO 全局关闭。
# AUTOLINK_IGNORE_WORDS 中列出的单词不会自动链接。
# 默认值：YES。

AUTOLINK_SUPPORT       = YES

# 指定一个单词列表；当文档中的单词以其中某项开头时，即使 AUTOLINK_SUPPORT 启用了自动链接，
# 也不为其生成自动链接。此列表不影响使用 \# 或 \link 等命令显式创建的链接。
# 此项要求 AUTOLINK_SUPPORT 设为 YES。

AUTOLINK_IGNORE_WORDS  =

# 使用 STL 类（如 std::string、std::vector）但不想将 STL 源码或其标签文件作为输入时，
# 设为 YES 可让 Doxygen 匹配参数包含 STL 类的函数声明与定义（例如 func(std::string); 和 func(std::string) {}），
# 也可使涉及 STL 类的继承图和协作图更完整、准确。
# 默认值：NO。

BUILTIN_STL_SUPPORT    = NO

# 使用 Microsoft C++/CLI 语言时，设为 YES 可启用解析支持。
# 默认值：NO。

CPP_CLI_SUPPORT        = NO

# 如果项目只包含 sip 源文件（参见 https://www.riverbankcomputing.com/software），
# 设为 YES 后 Doxygen 会像解析普通 C++ 一样解析它们；但未显式指定访问权限时，
# 假定所有类采用 public 而非 private 继承。
# 默认值：NO。

SIP_SUPPORT            = NO

# Microsoft IDL 使用 propget 和 propput 属性标记属性的 getter 和 setter。设为 YES 后，
# Doxygen 在文档中用属性替换 get 和 set 方法，但仅适用于这些方法确实读取或设置简单类型的情况。否则，
# 或希望始终显示这些方法时，应设为 NO。
# 默认值：YES。

IDL_PROPERTY_SUPPORT   = YES

# 使用成员分组且此项为 YES 时，Doxygen 将组中第一个成员的文档（如果有）复用于其他成员。
# 默认情况下必须为每个成员显式编写文档。
# 默认值：NO。

DISTRIBUTE_GROUP_DOC   = NO

# 启用后，将结构体或类加入组时，其嵌套类或结构体也会加入同一组。默认关闭，
# 必须通过 \ingroup 显式添加嵌套复合类型。
# 默认值：NO。

GROUP_NESTED_COMPOUNDS = NO

# 设为 YES 时，允许将同类型的类成员组（例如 public 函数组）作为该类型的子组，
# 显示在相应部分（例如 Public Functions）下；设为 NO 则禁止。也可通过 \nosubgrouping 命令按类设置。
# 默认值：YES。

SUBGROUPING            = YES

# 设为 YES 时，类、结构体和联合体显示在它们所属的组中（例如通过 \ingroup 加入），
# 而不是单独的页面（HTML 和 Man）或章节（LaTeX 和 RTF）中。
# 此功能不能与 SEPARATE_MEMBER_PAGES 同时使用。
# 默认值：NO。

INLINE_GROUPED_CLASSES = NO

# 设为 YES 时，仅包含 public 数据字段或简单 typedef 字段的结构体、类和联合体，
# 会内联显示在其定义所在作用域的文档中（文件、命名空间或组文档），前提是该作用域有文档。设为 NO 时，
# 它们显示在单独的页面（HTML 和 Man）或章节（LaTeX 和 RTF）中。
# 默认值：NO。

INLINE_SIMPLE_STRUCTS  = NO

# 启用后，结构体、联合体或枚举的 typedef 会以 typedef 名称作为相应类型的名称生成文档。
# 例如 typedef struct TypeS {} TypeT 显示为名为 TypeT 的结构体。关闭时，typedef 显示为文件、
# 命名空间或类的成员，结构体名为 TypeS。对于只引用 typedef 名称而不引用类型标签名的 C 代码，
# 这通常很有用。
# 默认值：NO。

TYPEDEF_HIDES_STRUCT   = NO

# 设置符号查找缓存大小，用于根据名称和作用域解析符号。由于解析开销较大且同一符号常多次出现，
# Doxygen 会缓存解析结果；缓存太小会降低速度，太大则浪费内存。大小公式为 2^(16+LOOKUP_CACHE_SIZE)，
# 有效范围为 0..9；默认 0 对应 2^16=65536 个符号。
# 运行结束时 Doxygen 会报告缓存使用情况并从速度角度建议最佳大小。
# 最小值：0，最大值：9，默认值：0。

LOOKUP_CACHE_SIZE      = 0

# 指定 Doxygen 处理时允许使用的线程数。设为 0 时根据系统可用核心数决定；
# 设为大于 0 的值可以更好地平衡 CPU 负载与处理速度。目前只有输入处理支持多线程。
# 由于此功能仍处于实验阶段，默认值为 1，即实际禁用并行处理；遇到问题请报告。
# dot 图的并行生成由 DOT_NUM_THREADS 控制。
# 最小值：0，最大值：512，默认值：1。

NUM_PROC_THREADS       = 1

# 设为 NO 以外的值时，每个生成页面包含生成日期或日期和时间；设为 NO 有助于比较多次运行的输出。
# 可选值：YES、NO、DATETIME、DATE。
# 默认值：NO。

TIMESTAMP              = NO

#---------------------------------------------------------------------------
# 文档构建相关配置选项
#---------------------------------------------------------------------------

# 设为 YES 时，即使没有实际文档，Doxygen 也假定所有实体均有文档。
# 除非分别将 EXTRACT_PRIVATE 和 EXTRACT_STATIC 设为 YES，否则私有类成员和文件静态成员仍会隐藏。
# 注意：此项还会关闭 WARNINGS 为 YES 时通常产生的未编写文档的成员警告。
# 默认值：NO。

EXTRACT_ALL            = YES

# 设为 YES 时，类的所有 private 成员都包含在文档中。
# 默认值：NO。

EXTRACT_PRIVATE        = NO

# 设为 YES 时，类中已有文档的 private 虚方法包含在文档中。
# 默认值：NO。

EXTRACT_PRIV_VIRTUAL   = NO

# 设为 YES 时，所有 package 或 internal 作用域的成员包含在文档中。
# 默认值：NO。

EXTRACT_PACKAGE        = NO

# 设为 YES 时，文件的所有静态成员包含在文档中。
# 默认值：NO。

EXTRACT_STATIC         = NO

# 设为 YES 时，包含源文件中局部定义的类和结构体；设为 NO 时仅包含头文件中定义的类。
# 此项对 Java 源文件无效。
# 默认值：YES。

EXTRACT_LOCAL_CLASSES  = YES

# 此项仅对 Objective-C 代码有用。设为 YES 时，文档包含在实现部分定义但不在接口中声明的局部方法；
# 设为 NO 时仅包含接口中的方法。
# 默认值：NO。

EXTRACT_LOCAL_METHODS  = NO

# 设为 YES 时，提取匿名命名空间的成员，并将其显示在名为 'anonymous_namespace{file}' 的命名空间中，
# 其中 file 替换为包含该匿名命名空间的文件基本名称。默认隐藏匿名命名空间。
# 默认值：NO。

EXTRACT_ANON_NSPACES   = NO

